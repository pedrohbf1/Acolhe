{
  "name": "@useacolhe/api",
  "private": true,
  "version": "0.0.1",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "type-check": "tsc --noEmit",
    "test": "bun test src",
    "db:migrate": "bunx prisma migrate dev && bunx prisma generate",
    "db:migrate:deploy": "bunx prisma migrate deploy && bunx prisma generate",
    "db:generate": "bunx prisma generate",
    "db:studio": "bunx prisma studio"
  },
  "dependencies": {
    "@better-auth/stripe": "^1.6.9",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/openapi": "^1.4.14",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@sinclair/typebox": "^0.34.49",
    "better-auth": "^1.6.0",
    "better-auth-localization": "^3.0.0",
    "dotenv": "^17.4.1",
    "elysia": "^1.3.1",
    "elysia-rate-limit": "^4.5.1",
    "pg": "^8.20.0",
    "resend": "^6.12.2",
    "stripe": "^22.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@useacolhe/tsconfig": "*",
    "@types/bun": "latest",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "prisma": "^7.7.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
