NODE_ENV=development
PORT=3333

# URLs
SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Better Auth
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3333
AUTH_BASE_URL=/api/auth

# Database (Supabase)
# - DATABASE_URL: pooler (porta 6543, PgBouncer) — usado pela aplicação em runtime
# - DIRECT_URL:   conexão direta (porta 5432) — usada por `prisma migrate`
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Stripe
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Para dev local: `stripe listen --forward-to localhost:3333/api/auth/stripe/webhook`
# copia o whsec_... que o CLI imprime
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend (email transacional)
# https://resend.com/api-keys
RESEND_API_KEY=re_xxx
# Em dev pode usar onboarding@resend.dev. Em prod, use um domínio verificado.
RESEND_FROM_EMAIL="useAcolhe <onboarding@resend.dev>"

# Stripe Price IDs (test mode)
# Crie os produtos em https://dashboard.stripe.com/test/products
# e cole os Price IDs (começam com `price_`) aqui
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_TEAM_MONTHLY=price_xxx
# opcionais (anuais com desconto)
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_YEARLY=
